{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "types": []
  },
  "include": ["src/core/**/*.ts", "src/sample/**/*.ts", "src/viewer/**/*.ts", "src/globals.d.ts"]
}
